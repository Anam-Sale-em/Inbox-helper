# Optional: Gmail and Google Calendar (README: Gmail and Google Calendar)
GMAIL_QUERY=label:inbox-helper newer_than:14d
CAL_ID=primary
CAL_DAYS_AHEAD=5
CAL_DAY_START=10
CAL_DAY_END=18
CAL_SLOT_MINUTES=45
CAL_LEAD_HOURS=12
